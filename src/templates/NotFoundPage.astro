---
import { translator, localeFromPath, localizePath } from "../i18n";
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);

import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import SchematicDivider from "../components/SchematicDivider.astro";
---

<BaseLayout title={t("Page Not Found")} description={t("The page you're looking for doesn't exist.")}>
  <section class="min-h-[60vh] flex items-center bg-ink">
    <div class="max-w-7xl mx-auto px-5 md:px-16 text-center">
      <span class="animate-fade-up text-6xl md:text-8xl font-bold text-signal/20 block mb-4">404</span>
      <h1 class="animate-fade-up animate-fade-up-2 text-2xl md:text-3xl font-bold text-paper tracking-tight mb-4">{t("Page not found")}</h1>
      <p class="animate-fade-up animate-fade-up-3 text-slate mb-8 max-w-md mx-auto">
        {t("The page you're looking for doesn't exist or has been moved.")}
      </p>
      <div class="animate-fade-up animate-fade-up-4">
        <SchematicDivider class="max-w-sm mx-auto mb-8 opacity-40" />
        <Button href={localizePath("/", locale)} variant="primary">{t("Back to Home")}</Button>
      </div>
    </div>
  </section>
</BaseLayout>

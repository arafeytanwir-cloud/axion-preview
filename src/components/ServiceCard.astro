---
import { translator, localeFromPath, localizePath } from "../i18n";
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);

interface Props {
  title: string;
  description: string;
  href: string;
  image?: string;
  pillar: "power" | "it";
  class?: string;
}

const { title, description, href, pillar, class: className = "" } = Astro.props;
---

<a
  href={localizePath(href, locale)}
  class:list={[
    "group block p-5 border border-line rounded-md bg-paper transition-all duration-300",
    pillar === "power"
      ? "hover:border-signal/40"
      : "hover:border-copper/40",
    className
  ]}
>
  <div class:list={[
    "w-1 h-8 rounded-full mb-3",
    pillar === "power" ? "bg-signal" : "bg-copper"
  ]}></div>

  <h3 class="text-lg font-bold text-ink tracking-tight mb-2 group-hover:text-signal-text transition-colors duration-200">
    {t(title)}
  </h3>

  <p class="text-slate text-sm leading-relaxed">
    {t(description)}
  </p>

  <span class:list={[
    "inline-flex items-center gap-1 mt-4 text-xs font-semibold uppercase tracking-wider transition-colors duration-200",
    pillar === "power"
      ? "text-signal-text group-hover:text-signal-text/80"
      : "text-copper group-hover:text-copper/80"
  ]}>
    {t("Learn more")}
    <svg class="directional-icon w-3 h-3 transition-transform group-hover:translate-x-1 rtl:group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path d="M5 12h14M12 5l7 7-7 7" />
    </svg>
  </span>
</a>

---
interface Props {
  class?: string;
  animated?: boolean;
}

const { class: className = "", animated = false } = Astro.props;
---

<div class:list={["w-full overflow-hidden", className]}>
  <svg
    class="w-full h-12 md:h-16"
    viewBox="0 0 1200 60"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <line
      x1="0" y1="30" x2="1200" y2="30"
      stroke="var(--color-line)"
      stroke-width="1"
      class={animated ? "schematic-line" : ""}
    />
    <!-- Nodes along the line -->
    <circle cx="200" cy="30" r="3" fill="var(--color-signal)" class={animated ? "schematic-node delay-1" : ""} />
    <circle cx="500" cy="30" r="3" fill="var(--color-signal)" class={animated ? "schematic-node delay-2" : ""} />
    <circle cx="800" cy="30" r="3" fill="var(--color-signal)" class={animated ? "schematic-node delay-3" : ""} />
    <!-- Branch lines -->
    <line x1="200" y1="30" x2="200" y2="10" stroke="var(--color-line)" stroke-width="1" />
    <line x1="500" y1="30" x2="500" y2="50" stroke="var(--color-line)" stroke-width="1" />
    <line x1="800" y1="30" x2="800" y2="10" stroke="var(--color-line)" stroke-width="1" />
    <!-- Small terminal marks -->
    <line x1="196" y1="10" x2="204" y2="10" stroke="var(--color-signal)" stroke-width="1" />
    <line x1="496" y1="50" x2="504" y2="50" stroke="var(--color-signal)" stroke-width="1" />
    <line x1="796" y1="10" x2="804" y2="10" stroke="var(--color-signal)" stroke-width="1" />
  </svg>
</div>

<style>
  .schematic-line {
    stroke-dasharray: 1200;
    stroke-dashoffset: 1200;
    animation: draw-in 2s ease-out forwards;
  }

  .schematic-node {
    animation: pulse-node 3s ease-in-out infinite;
  }

  .delay-1 { animation-delay: 0.5s; }
  .delay-2 { animation-delay: 1s; }
  .delay-3 { animation-delay: 1.5s; }
</style>

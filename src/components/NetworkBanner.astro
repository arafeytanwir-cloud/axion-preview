---
---
<div
  class="absolute inset-0 overflow-hidden pointer-events-none"
  style="background: radial-gradient(120% 140% at 8% 60%, #0d2413 0%, #051208 45%, #020805 100%);"
  aria-hidden="true"
  data-network-banner
>
  <canvas data-network-banner-canvas class="block w-full h-full"></canvas>
</div>

<script is:inline>
  (() => {
    let cleanup = null;

    function initNetworkBanner() {
      const container = document.querySelector('[data-network-banner]');
      const canvas = document.querySelector('[data-network-banner-canvas]');
      if (!container || !canvas || canvas.dataset.inited) return;
      canvas.dataset.inited = 'true';

      if (cleanup) cleanup();
      cleanup = null;

      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      let W = 0, H = 0, DPR = 1;

      function resize() {
        DPR = Math.min(window.devicePixelRatio || 1, 2);
        W = container.clientWidth;
        H = container.clientHeight;
        canvas.width = Math.max(1, Math.floor(W * DPR));
        canvas.height = Math.max(1, Math.floor(H * DPR));
        ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      }

      const ro = new ResizeObserver(resize);
      ro.observe(container);
      resize();

      // helper: the spine curve that the mesh flows along (mimics reference banner)
      function spineY(xNorm) {
        const t = xNorm;
        return 0.82 - 0.62 * Math.pow(t, 1.15) + 0.10 * Math.sin(t * Math.PI * 0.5);
      }

      // bokeh particles (left side glow orbs)
      const bokehCount = 26;
      const bokeh = [];
      for (let i = 0; i < bokehCount; i++) {
        const xNorm = Math.random() * 0.38;
        bokeh.push({
          xNorm,
          yOff: (Math.random() - 0.5) * 0.22,
          r: 6 + Math.random() * 34,
          baseAlpha: 0.08 + Math.random() * 0.22,
          phase: Math.random() * Math.PI * 2,
          speed: 0.15 + Math.random() * 0.25,
          driftX: 0.00006 + Math.random() * 0.00014,
        });
      }

      // mesh network nodes
      const nodeCount = 140;
      const nodes = [];
      for (let i = 0; i < nodeCount; i++) {
        const xNorm = 0.05 + Math.random() * 1.05;
        const spread = 0.16 + 0.28 * Math.min(xNorm, 1);
        nodes.push({
          baseXNorm: xNorm,
          baseYOff: (Math.random() - 0.5) * spread,
          phase: Math.random() * Math.PI * 2,
          speed: 0.06 + Math.random() * 0.10,
          r: 1.1 + Math.random() * 2.1,
          flowSpeed: 0.010 + Math.random() * 0.016,
        });
      }

      const maxLinkDist = 95;

      function project(n, t) {
        let xNorm = (n.baseXNorm + t * n.flowSpeed) % 1.15;
        if (xNorm < 0) xNorm += 1.15;
        xNorm -= 0.05;
        const bob = Math.sin(t * n.speed + n.phase) * 0.018;
        const x = (xNorm + bob) * W;
        const sy = spineY(Math.max(0, Math.min(1, xNorm))) * H;
        const y = sy + n.baseYOff * H + Math.cos(t * n.speed * 1.3 + n.phase) * 9;
        const edgeFade = Math.min(1, xNorm / 0.06) * Math.min(1, (1.05 - xNorm) / 0.06);
        return { x, y, xNorm, edgeFade: Math.max(0, Math.min(1, edgeFade)) };
      }

      let t0 = performance.now();

      function draw(t) {
        if (W === 0 || H === 0) return;
        ctx.clearRect(0, 0, W, H);

        // bokeh orbs
        for (const b of bokeh) {
          const xNorm = b.xNorm + t * b.driftX;
          const x = xNorm * W;
          const y = (spineY(xNorm) + b.yOff) * H;
          const flicker = 0.75 + 0.25 * Math.sin(t * b.speed + b.phase);
          const alpha = b.baseAlpha * flicker;
          const grad = ctx.createRadialGradient(x, y, 0, x, y, b.r);
          grad.addColorStop(0, `rgba(120,255,170,${alpha})`);
          grad.addColorStop(0.5, `rgba(70,220,140,${alpha * 0.4})`);
          grad.addColorStop(1, 'rgba(20,120,80,0)');
          ctx.fillStyle = grad;
          ctx.beginPath();
          ctx.arc(x, y, b.r, 0, Math.PI * 2);
          ctx.fill();
        }

        // compute node positions
        const pts = nodes.map(n => project(n, t));

        // links
        ctx.lineWidth = 0.6;
        for (let i = 0; i < pts.length; i++) {
          for (let j = i + 1; j < pts.length; j++) {
            const dx = pts[i].x - pts[j].x;
            const dy = pts[i].y - pts[j].y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < maxLinkDist) {
              const density = (pts[i].xNorm + pts[j].xNorm) / 2;
              const fade = Math.min(pts[i].edgeFade, pts[j].edgeFade);
              const alpha = (1 - dist / maxLinkDist) * (0.08 + density * 0.35) * fade;
              ctx.strokeStyle = `rgba(110,240,160,${alpha})`;
              ctx.beginPath();
              ctx.moveTo(pts[i].x, pts[i].y);
              ctx.lineTo(pts[j].x, pts[j].y);
              ctx.stroke();
            }
          }
        }

        // long "trunk" lines sweeping across
        ctx.lineWidth = 1;
        const trunkPath = [];
        for (let k = 0; k < 5; k++) {
          const yBase = 0.55 + k * 0.09;
          ctx.strokeStyle = `rgba(140,255,190,${0.05 + 0.03 * k})`;
          ctx.beginPath();
          const pts2 = [];
          for (let xN = 0; xN <= 1; xN += 0.02) {
            const x = xN * W;
            const y = (spineY(xN) + (yBase - 0.55) * 0.3 + Math.sin(xN * 6 + t * 0.4 + k) * 0.014) * H;
            pts2.push({ x, y, xN });
            if (xN === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
          }
          ctx.stroke();
          trunkPath.push(pts2);
        }

        // traveling light pulses riding the trunk lines
        for (let k = 0; k < trunkPath.length; k++) {
          const pulseXN = (t * (0.10 + k * 0.015) + k * 0.37) % 1;
          const seg = trunkPath[k];
          const idx = Math.max(0, Math.min(seg.length - 1, Math.floor(pulseXN * (seg.length - 1))));
          const pt = seg[idx];
          const fade = Math.sin(pulseXN * Math.PI);
          const grad = ctx.createRadialGradient(pt.x, pt.y, 0, pt.x, pt.y, 16);
          grad.addColorStop(0, `rgba(190,255,215,${0.5 * fade})`);
          grad.addColorStop(1, 'rgba(120,255,170,0)');
          ctx.fillStyle = grad;
          ctx.beginPath();
          ctx.arc(pt.x, pt.y, 16, 0, Math.PI * 2);
          ctx.fill();
        }

        // nodes (glowing dots)
        for (let i = 0; i < pts.length; i++) {
          const n = nodes[i];
          const p = pts[i];
          const pulse = 0.6 + 0.4 * Math.sin(t * 1.4 + n.phase);
          const glowR = n.r * (2.4 + pulse * 1.2);
          const grad = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, glowR);
          const coreAlpha = (0.5 + Math.max(0, Math.min(1, p.xNorm)) * 0.5) * p.edgeFade;
          grad.addColorStop(0, `rgba(180,255,210,${coreAlpha})`);
          grad.addColorStop(1, 'rgba(120,255,170,0)');
          ctx.fillStyle = grad;
          ctx.beginPath();
          ctx.arc(p.x, p.y, glowR, 0, Math.PI * 2);
          ctx.fill();

          ctx.fillStyle = `rgba(200,255,220,${(0.7 + Math.max(0, Math.min(1, p.xNorm)) * 0.3) * p.edgeFade})`;
          ctx.beginPath();
          ctx.arc(p.x, p.y, n.r, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      let running = false;
      let rafId = 0;
      let pausedAt = 0;
      let isVisible = false;

      function tick(now) {
        rafId = requestAnimationFrame(tick);
        draw((now - t0) / 1000);
      }

      function start(now) {
        if (running) return;
        running = true;
        if (pausedAt) t0 += now - pausedAt;
        pausedAt = 0;
        rafId = requestAnimationFrame(tick);
      }

      function stop(now) {
        if (!running) return;
        running = false;
        pausedAt = now;
        cancelAnimationFrame(rafId);
      }

      function onMotionChange() {
        if (reducedMotion.matches) {
          stop(performance.now());
          draw(0);
        } else if (isVisible) {
          start(performance.now());
        }
      }

      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          isVisible = entry.isIntersecting;
          if (reducedMotion.matches) return;
          if (isVisible) start(performance.now());
          else stop(performance.now());
        });
      }, { threshold: 0.02 });
      io.observe(container);
      reducedMotion.addEventListener('change', onMotionChange);

      if (reducedMotion.matches) draw(0);

      cleanup = () => {
        if (running) cancelAnimationFrame(rafId);
        running = false;
        io.disconnect();
        ro.disconnect();
        reducedMotion.removeEventListener('change', onMotionChange);
      };
    }

    initNetworkBanner();
    document.addEventListener('astro:page-load', initNetworkBanner);
  })();
</script>

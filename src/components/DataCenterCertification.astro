  <!-- CLOSING CTA -->
  <h2 class="text-2xl md:text-3xl font-bold text-ink tracking-tight mb-4">
    {t("Find out how close you are to certification")}
  </h2>
  <p class="text-ink/80 leading-relaxed mb-6">
    {t("Tell us your target level and a few details about your facility, and we will recommend a clear next step.")}
  </p>
  <div class="mb-10">
    <Button href={localizePath("/contact", locale)} variant="primary">{t("Request a readiness assessment")}</Button>
  </div>

  <!-- FINE PRINT -->
  <p class="text-xs text-ink/50 leading-relaxed mb-2">
    {t("Axion Smart Company is an independent company. ANSI/TIA-942 is a standard of the Telecommunications Industry Association, and TIA-942 certificates are issued by TIA-licensed Certification Bodies. Tier Certification is awarded solely by Uptime Institute. All names and marks belong to their owners.")}
  </p>
</div>